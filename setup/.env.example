# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=biz_cash_flow
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Dev local : app sur la machine (npm run dev), seule la BD tourne dans Docker
#   docker compose up -d
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:change_me_secure_password@localhost:5432/biz_cash_flow
NEXT_PUBLIC_APP_NAME=Biz Cash Flow
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
APP_PORT=3000

# ---------------------------------------------------------------------------
# Production (docker compose --profile prod up --build -d) :
# remplace DATABASE_URL par l'hote Docker `db` et NODE_ENV=production
#
# DATABASE_URL=postgresql://postgres:change_me_secure_password@db:5432/biz_cash_flow
# NODE_ENV=production
# ---------------------------------------------------------------------------
