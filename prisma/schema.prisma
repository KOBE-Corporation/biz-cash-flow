generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum AccountEntryType {
  INCOME
  EXPENSE
  ASSET
  LIABILITY
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RECEIVE
  CANCEL
  SALE
  ADJUST
  LOGIN
  OTHER
}

model User {
  id String @id @default(cuid())
  email String @unique
  name  String

  invoices              Invoice[]              @relation("InvoiceIssuer")
  stockMovements        StockMovement[]
  categoriesCreated     Category[]             @relation("CategoryCreatedBy")
  categoriesUpdated     Category[]             @relation("CategoryUpdatedBy")
  suppliersCreated      Supplier[]             @relation("SupplierCreatedBy")
  suppliersUpdated      Supplier[]             @relation("SupplierUpdatedBy")
  productsCreated       Product[]              @relation("ProductCreatedBy")
  productsUpdated       Product[]              @relation("ProductUpdatedBy")
  purchasesCreated      Purchase[]             @relation("PurchaseCreatedBy")
  purchasesUpdated      Purchase[]             @relation("PurchaseUpdatedBy")
  purchasesReceived     Purchase[]             @relation("PurchaseReceivedBy")
  purchasesCancelled    Purchase[]             @relation("PurchaseCancelledBy")
  offersCreated         ProductSupplierOffer[] @relation("OfferCreatedBy")
  offersUpdated         ProductSupplierOffer[] @relation("OfferUpdatedBy")
  accountEntries        AccountEntry[]
  auditLogs             AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id           String    @id @default(cuid())
  name         String    @unique
  description  String?
  baseUnitName String    @default("unite")
  /// JSON: [{ id, name, unitsOfBase }]
  packLevels   Json      @default("[]")
  isActive     Boolean   @default(true)
  products     Product[]
  createdById  String
  createdBy    User      @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  updatedById  String?
  updatedBy    User?     @relation("CategoryUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([createdById])
  @@index([updatedById])
}

model Supplier {
  id          String                 @id @default(cuid())
  name        String
  email       String?
  phone       String?
  address     String?
  notes       String?
  isActive    Boolean                @default(true)
  products    Product[]
  purchases   Purchase[]
  offers      ProductSupplierOffer[]
  createdById String
  createdBy   User                   @relation("SupplierCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?                  @relation("SupplierUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([createdById])
  @@index([updatedById])
}

model Product {
  id             String                 @id @default(cuid())
  name           String
  sku            String                 @unique
  barcode        String                 @unique
  description    String?
  quantity       Int                    @default(0)
  minStock       Int                    @default(0)
  purchasePrice  Decimal                @default(0) @db.Decimal(12, 2)
  salePrice      Decimal                @default(0) @db.Decimal(12, 2)
  baseUnitName   String                 @default("unite")
  /// JSON: [{ id, name, unitsOfBase, salePrice }]
  packLevels     Json                   @default("[]")
  isActive       Boolean                @default(true)
  categoryId     String
  category       Category               @relation(fields: [categoryId], references: [id])
  supplierId     String?
  supplier       Supplier?              @relation(fields: [supplierId], references: [id])
  movements      StockMovement[]
  invoiceItems   InvoiceItem[]
  purchaseItems  PurchaseItem[]
  supplierOffers ProductSupplierOffer[]
  createdById    String
  createdBy      User                   @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedById    String?
  updatedBy      User?                  @relation("ProductUpdatedBy", fields: [updatedById], references: [id])
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([categoryId])
  @@index([supplierId])
  @@index([sku])
  @@index([barcode])
  @@index([isActive])
  @@index([createdById])
  @@index([updatedById])
}

model ProductSupplierOffer {
  id                   String   @id @default(cuid())
  productId            String
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId           String
  supplier             Supplier @relation(fields: [supplierId], references: [id])
  packPurchasePrice    Decimal  @db.Decimal(12, 2)
  purchasePackName     String
  unitsPerPurchasePack Int
  costPerBaseUnit      Decimal  @db.Decimal(12, 2)
  lastPurchaseAt       DateTime @default(now())
  createdById          String
  createdBy            User     @relation("OfferCreatedBy", fields: [createdById], references: [id])
  updatedById          String?
  updatedBy            User?    @relation("OfferUpdatedBy", fields: [updatedById], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([productId, supplierId, purchasePackName])
  @@index([productId])
  @@index([supplierId])
  @@index([createdById])
}

model StockMovement {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  type        MovementType
  quantity    Int
  unitPrice   Decimal?     @db.Decimal(12, 2)
  reference   String?
  notes       String?
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([productId])
  @@index([createdAt])
  @@index([createdById])
}

model Purchase {
  id            String         @id @default(cuid())
  reference     String         @unique
  supplierId    String?
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  status        PurchaseStatus @default(PENDING)
  totalAmount   Decimal        @default(0) @db.Decimal(12, 2)
  notes         String?
  purchasedAt   DateTime       @default(now())
  items         PurchaseItem[]
  createdById   String
  createdBy     User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  updatedById   String?
  updatedBy     User?          @relation("PurchaseUpdatedBy", fields: [updatedById], references: [id])
  receivedById  String?
  receivedBy    User?          @relation("PurchaseReceivedBy", fields: [receivedById], references: [id])
  cancelledById String?
  cancelledBy   User?          @relation("PurchaseCancelledBy", fields: [cancelledById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([createdById])
  @@index([receivedById])
}

model PurchaseItem {
  id                   String   @id @default(cuid())
  purchaseId           String
  purchase             Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId            String
  product              Product  @relation(fields: [productId], references: [id])
  quantity             Int
  unitPrice            Decimal  @db.Decimal(12, 2)
  purchasePackName     String   @default("lot")
  unitsPerPurchasePack Int      @default(1)

  @@index([purchaseId])
  @@index([productId])
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  customerName   String
  status         InvoiceStatus @default(PAID)
  paymentMethod  PaymentMethod @default(CASH)
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @default(0) @db.Decimal(12, 2)
  amountReceived Decimal?      @db.Decimal(12, 2)
  changeDue      Decimal?      @db.Decimal(12, 2)
  notes          String?
  issuedAt       DateTime      @default(now())
  issuedById     String
  issuedBy       User          @relation("InvoiceIssuer", fields: [issuedById], references: [id])
  items          InvoiceItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([issuedById])
  @@index([issuedAt])
  @@index([status])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  productName String
  productSku  String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  unitsOfBase Int?
  packName    String?

  @@index([invoiceId])
  @@index([productId])
}

model AccountEntry {
  id          String           @id @default(cuid())
  type        AccountEntryType
  label       String
  amount      Decimal          @db.Decimal(12, 2)
  reference   String?
  description String?
  recordedAt  DateTime         @default(now())
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())

  @@index([recordedAt])
  @@index([type])
  @@index([createdById])
}

/// Journal d'activite pour tracabilite ulterieure (qui / quoi / quand).
model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}
